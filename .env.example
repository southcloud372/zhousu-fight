# 换供应商只改这三行（任何 Anthropic 兼容端点都行）
LLM_BASE_URL=https://api.deepseek.com/anthropic
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 全部走 flash。想给"开局生成/战斗判定"单独用更强的模型，
# 把下面这行改成 deepseek-v4-pro 即可 —— 调用点不用动。
LLM_MODEL=deepseek-flash
LLM_MODEL_PRO=deepseek-flash

PORT=8787

# 每 100 万 token 的价格（示例值，按实际账单替换）。留空则只显示 token 数。
PRICE_FLASH_IN=2
PRICE_FLASH_OUT=8
PRICE_CACHE_READ=0.5
PRICE_CURRENCY=¥
