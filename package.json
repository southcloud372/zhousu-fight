{
  "name": "game-sunuo",
  "version": "0.1.0",
  "private": true,
  "description": "《咒术回战》世界观文字游戏 —— 引擎管数值、AI 管叙事，可本地运行的网页游戏",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "text-game",
    "llm",
    "ai",
    "react",
    "vite",
    "game",
    "anthropic",
    "deepseek"
  ],
  "scripts": {
    "dev": "concurrently -n SERVER,WEB -c cyan,magenta \"node --watch server/index.js\" \"vite\"",
    "server": "node --watch server/index.js",
    "web": "vite",
    "build": "vite build",
    "test": "node --test tests/engine.test.mjs tests/llm.test.mjs tests/contract.test.mjs tests/runtime.test.mjs tests/constants.test.mjs tests/typewriter.test.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "test:ui": "vite build && node --test tests/ui.test.mjs",
    "test:all": "npm test && npm run test:ui",
    "playtest": "node tools/playtest.mjs",
    "verify": "npm test && npm run test:ui && npm run test:e2e"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "jsdom": "^29.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.7"
  }
}
